
# 新的通用配置（推荐）
LLM_PROVIDER=openai          # "openai" | "anthropic"
LLM_API_KEY=your-key
LLM_MODEL=deepseek-v3.2
LLM_BASE_URL=https://qianfan.baidubce.com/v2

# Tavily Web Search API key for the built-in web_search tool.
TAVILY_API_KEY=tvly-your-key

FEISHU_ENABLED=true
FEISHU_APP_ID=cli_你的app_id
FEISHU_APP_SECRET=你的app_secret
FEISHU_VERIFICATION_TOKEN=你的verification_token
FEISHU_ENCRYPT_KEY=cleozhang         # 事件订阅页获取（可选，但建议开启）

EMBEDDING_API_KEY="你的千帆 key"
EMBEDDING_MODEL="qwen3-embedding-8b"
EMBEDDING_BASE_URL="https://qianfan.baidubce.com/v2"

# Rerank
RERANK_API_KEY=your-api-key
RERANK_MODEL=qwen3-reranker-8b
RERANK_BASE_URL=https://qianfan.baidubce.com/v2/rerank
